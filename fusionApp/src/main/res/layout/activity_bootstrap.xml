<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bootstrap_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/bootstrap_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="FusionCore"
        android:textColor="@color/bootstrap_title"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/bootstrap_game"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Starting Among Us"
        android:textColor="@color/bootstrap_subtitle"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/bootstrap_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/bootstrap_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/bootstrap_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/bootstrap_game"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/bootstrap_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="0%"
                android:textColor="@color/bootstrap_accent"
                android:textSize="46sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/bootstrap_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Initializing"
                android:textColor="@color/bootstrap_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/bootstrap_operation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Preparing..."
                android:textColor="@color/bootstrap_text_secondary"
                android:textSize="14sp"/>

            <ProgressBar
                android:id="@+id/bootstrap_download_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="18dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/bootstrap_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/bootstrap_text_secondary"
                android:textSize="12sp"/>

        
    <Button
        android:id="@+id/btn_open_ide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Mini IDE"
        android:layout_margin="8dp" />

</LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/bootstrap_log_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bootstrap_log_background"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/bootstrap_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:id="@+id/bootstrap_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:padding="14dp">

            <TextView
                android:id="@+id/bootstrap_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="@color/bootstrap_text_secondary"
                android:textSize="12sp"/>

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/bootstrap_error_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="20dp"
        android:background="@color/bootstrap_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bootstrap failed"
            android:textColor="@color/bootstrap_title"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/bootstrap_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/bootstrap_text_secondary"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/bootstrap_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Retry"/>

    
    <Button
        android:id="@+id/btn_open_ide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Mini IDE"
        android:layout_margin="8dp" />

</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
