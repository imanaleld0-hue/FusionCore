<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fc_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/settings_action_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_back"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Settings"
                android:textColor="@color/fc_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Player" android:textColor="@color/fc_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <EditText
            android:id="@+id/settings_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nickname"
            android:textColor="@color/fc_text_primary"
            android:textColorHint="@color/fc_text_secondary"
            android:background="@android:drawable/edit_text" />
        <EditText
            android:id="@+id/settings_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Level"
            android:inputType="number"
            android:textColor="@color/fc_text_primary"
            android:textColorHint="@color/fc_text_secondary"
            android:background="@android:drawable/edit_text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Cache" android:textColor="@color/fc_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/settings_cache_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Cache: 0 B" android:textColor="@color/fc_text_secondary" android:textSize="13sp" />
        <Button
            android:id="@+id/settings_clear_cache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear Cache"
            android:backgroundTint="@color/fc_button_primary"
            android:textColor="@android:color/white" />
        <Button
            android:id="@+id/settings_refresh_cache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh Game Cache"
            android:backgroundTint="@color/fc_button_primary"
            android:textColor="@android:color/white" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Mods" android:textColor="@color/fc_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <Button
            android:id="@+id/settings_mods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage Mods"
            android:backgroundTint="@color/fc_button_primary"
            android:textColor="@android:color/white" />
        <Button
            android:id="@+id/settings_configs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Edit Configs"
            android:backgroundTint="@color/fc_button_primary"
            android:textColor="@android:color/white" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Logs" android:textColor="@color/fc_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Auto-clear old logs" android:textColor="@color/fc_text_secondary" android:textSize="14sp" />
            <Switch android:id="@+id/settings_auto_clear" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
