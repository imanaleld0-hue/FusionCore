<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selector_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bootstrap_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/selector_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FusionCore"
        android:textColor="@color/bootstrap_title"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/selector_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Among Us Launcher"
        android:textColor="@color/bootstrap_subtitle"
        android:textSize="16sp"
        android:gravity="center" />

    <Button
        android:id="@+id/selector_launch"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="Launch Game"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/selector_action_logs"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/bg_selector_card"
                android:scaleType="centerInside"
                android:contentDescription="@string/selector_action_logs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Logs"
                android:textColor="@color/bootstrap_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/selector_action_mods"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/bg_selector_card"
                android:scaleType="centerInside"
                android:contentDescription="@string/selector_action_mods" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Mods"
                android:textColor="@color/bootstrap_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/selector_action_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_settings"
                android:background="@drawable/bg_selector_card"
                android:scaleType="centerInside"
                android:contentDescription="@string/selector_action_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Settings"
                android:textColor="@color/bootstrap_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>