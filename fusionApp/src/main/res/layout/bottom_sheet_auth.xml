<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/fc_card_bg"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:background="@color/fc_text_disabled"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auth_enter_link"
        android:textColor="@color/fc_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/auth_enter_link_desc"
        android:textColor="@color/fc_text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/auth_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/auth_input_hint"
        android:textColor="@color/fc_text_primary"
        android:textColorHint="@color/fc_text_disabled"
        android:backgroundTint="@color/fc_card_border"
        android:minHeight="48dp"
        android:inputType="textUri|textMultiLine"
        android:gravity="top|start" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/auth_paste"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/paste"
            android:textColor="@color/fc_text_secondary" />

        <Button
            android:id="@+id/auth_submit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/auth_submit"
            android:backgroundTint="@color/fc_button_primary"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <Button
        android:id="@+id/auth_cancel"
        style="?attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/cancel"
        android:textColor="@color/fc_text_secondary" />
</LinearLayout>
